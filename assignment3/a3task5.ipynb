      "source": [
        "# Write your MySQL query statement below\n",
        "select employee.name from employee\n",
        "join (\n",
        "    select managerId from Employee\n",
        "    where managerId is not null\n",
        "    group by managerId\n",
        "    having count(*)>=5)\n",
        "as reportCount  on employee.id=reportCount.managerId"
      ]
    }
  ]
